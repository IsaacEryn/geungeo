LINER_API_KEY=
# 선택: 단계별 모델(비우면 기본값 liner-mark-1.3)
LINER_MODEL_ANALYZE=liner-mark-1.3
LINER_MODEL_ANSWER=liner-mark-1.3
LINER_MODEL_JUDGE=liner-mark-1.3
# 선택: 질문 분석의 추론 강도(none|low|medium|high|max, 비우면 low). Liner 기본값으로 되돌리려면 medium
LINER_REASONING_ANALYZE=
# 선택: 답변(조문 대조·판정)의 추론 강도(none|low|medium|high|max). 비우면 보내지 않고 Liner 기본값(medium)을 씁니다
LINER_REASONING_ANSWER=

# ── 배포할 때만(로컬 실행에서는 비워 두세요. 비어 있으면 아래 기능은 모두 꺼집니다) ──
# 접근 코드. 넣으면 화면에 접근 코드 입력칸이 생기고, 코드가 맞는 요청만 질문을 받습니다
ACCESS_CODE=
# 하루 질문 상한. 아래 세 값이 모두 있을 때만 켜집니다(Liner 사용량 조회로 셈, 외부 저장소 불필요)
# 하루에 받을 질문 수(예 200)
DAILY_QUESTION_LIMIT=
# 상한을 세기 시작한 날(한국 시간, YYYY-MM-DD). 이날부터 하루치 허용액이 날마다 쌓입니다
BUDGET_START_DATE=
# 시작한 날 배포 직전에 Liner GET /credits/usage의 summary.credits_usd 값(USD)
BUDGET_START_USD=
# 선택: 질문 한 건 예상 비용(USD, 비우면 0.02)
QUESTION_COST_USD=
# 같은 IP에서 1분에 받을 요청 수(예 6). 서버 인스턴스마다 따로 세는 보조 수단입니다
RATE_LIMIT_PER_MIN=
